# Copy this file to ".env" (same folder) and fill in your values.
# .env is git-ignored, so your keys never get uploaded.

# Your OpenAI API key - create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-key-here

# Any long random text (32+ characters) - keeps users signed in across restarts
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# Optional: Gmail address + 16-character app password to email reports and reset links
MAIL_USERNAME=
MAIL_PASSWORD=
