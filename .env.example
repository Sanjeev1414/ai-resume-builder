# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini (free) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Long random string (32+ characters) used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# MySQL root password (docker-compose creates the database with it)
DB_PASSWORD=change-me

# Optional - Gmail address + 16-character app password to email reports
MAIL_USERNAME=
MAIL_PASSWORD=
